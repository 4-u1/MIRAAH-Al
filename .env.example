# GEMINI_API_KEY: enables the AI assistant. Without it, AI routes return a clearly
# labelled fixed summary (source: "template"). Set it as a secret in your host; never commit it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model override (IDs from Google's published Gemini model list).
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# AI_REQUIRE_AUTH: when "true" (default) /api/ai/* requires a Firebase ID token
# (Authorization: Bearer <token>). Set "false" only for a closed demo.
AI_REQUIRE_AUTH="true"

# FIREBASE_PROJECT_ID: used to verify ID tokens. Defaults to projectId in firebase-applet-config.json.
FIREBASE_PROJECT_ID=""

# Rate limits for /api/ai/* per client IP.
AI_BURST_LIMIT="10"   # requests per 10 seconds
AI_DAILY_LIMIT="100"  # requests per day

# TRUST_PROXY: which proxies may set X-Forwarded-For (used to identify the client IP).
# "loopback" locally; "1" on Cloud Run or behind a single reverse proxy.
TRUST_PROXY="loopback"

# APP_URL: The URL where this applet is hosted (injected by AI Studio / Cloud Run).
APP_URL="MY_APP_URL"
