# GEMINI_API_KEY: enables the AI assistant. Without it, AI routes return a clearly
# labelled fixed summary (source: "template"). Set it as a secret in your host; never commit it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model override (IDs from Google's published Gemini model list).
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# AI_REQUIRE_AUTH: when "true" (default) /api/ai/* requires a Firebase ID token
# (Authorization: Bearer <token>). Set "false" only for a closed demo.
AI_REQUIRE_AUTH="true"

# FIREBASE_PROJECT_ID: used to verify ID tokens. Defaults to projectId in firebase-applet-config.json.
FIREBASE_PROJECT_ID=""

# Rate limits for /api/ai/* per client IP.
AI_BURST_LIMIT="10"   # requests per 10 seconds
AI_DAILY_LIMIT="100"  # requests per day

# TRUST_PROXY: which proxies may set X-Forwarded-For (used to identify the client IP).
# "loopback" locally; "1" on Cloud Run or behind a single reverse proxy.
# TRUST_PROXY="loopback"   # leave unset on Cloud Run (defaults to 1 there)

# APP_URL: The URL where this applet is hosted (injected by AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# ── Live workspace (real data) ──
# Comma-separated, verified Google emails with admin rights (assign roles; also inspect and review).
ADMIN_EMAILS="you@example.com"
# Ed25519 private key for signing passport exports. Generate with: node scripts/gen-signing-key.mjs
# Store it in Secret Manager; never commit it.
PASSPORT_SIGNING_KEY=""
# Storage for the live workspace: "sqlite" (default; database + photos under DATA_DIR on a
# persistent disk) or "firebase" (Firestore + Cloud Storage). Sign-in uses Firebase Auth either way.
WORKSPACE_STORE="sqlite"
DATA_DIR="./data"
# Firebase backend overrides (defaults come from firebase-applet-config.json)
# STORAGE_BUCKET="your-project.firebasestorage.app"
# FIRESTORE_DATABASE_ID="your-named-database"
# WORKSPACE_ENABLED="false"   # turn the live workspace off
