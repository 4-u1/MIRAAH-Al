rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile: Users can read and write only their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // User preferences subcollection
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }
      
      // User notification tracking subcollection
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Inspection audit log: append-only. A record must name its creator (uid and email from the
    // sign-in token, server time) and cannot be edited or deleted. Users read only their own records.
    match /inspections/{inspectionId} {
      allow read: if isAuthenticated() && resource.data.inspectorUid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['assetId', 'findingId', 'verified', 'isResolved', 'actionTaken', 'notes', 'inspectorUid', 'inspectorEmail', 'timestamp', 'createdAt'])
        && request.resource.data.keys().hasAll(['assetId', 'inspectorUid', 'createdAt'])
        && request.resource.data.inspectorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.assetId is string && request.resource.data.assetId.size() <= 64
        && (!('inspectorEmail' in request.resource.data) || request.resource.data.inspectorEmail == request.auth.token.email)
        && (!('findingId' in request.resource.data) || request.resource.data.findingId is int)
        && (!('verified' in request.resource.data) || request.resource.data.verified is bool)
        && (!('isResolved' in request.resource.data) || request.resource.data.isResolved is bool)
        && (!('actionTaken' in request.resource.data) || (request.resource.data.actionTaken is string && request.resource.data.actionTaken.size() <= 64))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
        && (!('timestamp' in request.resource.data) || (request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 40));
      allow update, delete: if false;
    }
  }
}
