rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile: Users can read and write only their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // User preferences subcollection
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }
      
      // User notification tracking subcollection
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Inspection audits & actions: Authenticated users can log verification or resolution notes
    match /inspections/{inspectionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.inspectorUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.inspectorUid == request.auth.uid;
    }
  }
}
